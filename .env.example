# The settings compose.yaml needs. Make .env with the command in the README rather than by hand; never commit it.

# The demo merchant's API key (at least 24 characters), sent in X-Api-Key.
GATEWAY_DEMO_MERCHANT_API_KEY=
# Secret key of the request fingerprints (at least 32 characters).
GATEWAY_FINGERPRINT_KEY=
# The key the gateway uses with acquirer-sim (at least 16 characters).
ACQUIRER_SIM_API_KEY=
# The secret the demo merchant's webhooks are signed with: whsec_ and 24 to 64 random bytes in Base64.
# merchant-sim checks the signatures with the same one.
GATEWAY_DEMO_MERCHANT_WEBHOOK_SECRET=

# Optional: host ports for docker compose, if the defaults are taken.
# GATEWAY_PORT=8090
# ACQUIRER_SIM_PORT=8091
# MONOBANK_SIM_PORT=8093
# MERCHANT_SIM_PORT=8092
# GATEWAY_DB_PORT=5436
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
# JAEGER_PORT=16686
# Optional: merchant-sim answers the first deliveries of each webhook 503, to show the gateway's retries.
# MERCHANT_SIM_FAIL_FIRST=1
# Optional: where new payments go, the preferred provider first. compose uses monobank,acquirer-sim.
# GATEWAY_PROVIDERS=acquirer-sim
# Optional: what a payment gets while risk-service can't check it: allow (it goes ahead) or decline (it fails).
# GATEWAY_RISK_WHEN_UNAVAILABLE=decline
# Optional: the real monobank instead of monobank-sim; set all three. The token is the merchant's from
# web.monobank.ua, or a test token from api.monobank.ua. The webhook URL is this gateway's
# /providers/monobank/webhooks at an address monobank can reach; left empty, monobank sends no webhooks.
# MONOBANK_URL=https://api.monobank.ua
# GATEWAY_MONOBANK_TOKEN=
# GATEWAY_MONOBANK_WEBHOOK_URL=
